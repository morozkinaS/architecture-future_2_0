<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 YaBrowser/24.10.0.0 Safari/537.36" version="25.0.3">
<diagram name="Автоматизация развёртывания" id="deploy-automation">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title_d" value="Диаграмма автоматизации развёртывания: что управляется Terraform, что выполняется вручную" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
<mxGeometry x="150" y="20" width="1100" height="40" as="geometry"/>
</mxCell>
<mxCell id="manual_d" value="Выполняется вручную" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
<mxGeometry x="50" y="90" width="360" height="560" as="geometry"/>
</mxCell>
<mxCell id="m1_d" value="1. Создание аккаунта Yandex Cloud&#10;(регистрация, платёжный аккаунт)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;" vertex="1" parent="manual_d">
<mxGeometry x="20" y="50" width="320" height="55" as="geometry"/>
</mxCell>
<mxCell id="m2_d" value="2. Получение IAM-токена / сервисного ключа&#10;(yc iam create-token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;" vertex="1" parent="manual_d">
<mxGeometry x="20" y="125" width="320" height="55" as="geometry"/>
</mxCell>
<mxCell id="m3_d" value="3. Заполнение terraform.tfvars:&#10;токен, cloud_id, folder_id, ssh-ключ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;" vertex="1" parent="manual_d">
<mxGeometry x="20" y="200" width="320" height="55" as="geometry"/>
</mxCell>
<mxCell id="m4_d" value="4. После apply (вручную):&#10;DNS-записи, настройка мониторинга,&#10;резервное копирование" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;" vertex="1" parent="manual_d">
<mxGeometry x="20" y="330" width="320" height="70" as="geometry"/>
</mxCell>
<mxCell id="m5_d" value="5. Эксплуатация и поддержка&#10;(доступы, обновления, инциденты)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;" vertex="1" parent="manual_d">
<mxGeometry x="20" y="430" width="320" height="60" as="geometry"/>
</mxCell>
<mxCell id="tf_d" value="Terraform (IaC) — автоматизация" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
<mxGeometry x="500" y="90" width="360" height="560" as="geometry"/>
</mxCell>
<mxCell id="t1_d" value="main.tf — описание ресурсов&#10;(network, subnet, NAT, VM, disk, security group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="tf_d">
<mxGeometry x="20" y="50" width="320" height="55" as="geometry"/>
</mxCell>
<mxCell id="t2_d" value="variables.tf — параметры&#10;(зона, размеры VM/диска, CIDR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="tf_d">
<mxGeometry x="20" y="125" width="320" height="55" as="geometry"/>
</mxCell>
<mxCell id="t3_d" value="outputs.tf — выходные значения&#10;(IP-адреса, id ресурсов)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="tf_d">
<mxGeometry x="20" y="200" width="320" height="55" as="geometry"/>
</mxCell>
<mxCell id="t4_d" value="terraform init — инициализация провайдера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="tf_d">
<mxGeometry x="20" y="285" width="320" height="45" as="geometry"/>
</mxCell>
<mxCell id="t5_d" value="terraform plan — проверка плана изменений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="tf_d">
<mxGeometry x="20" y="350" width="320" height="45" as="geometry"/>
</mxCell>
<mxCell id="t6_d" value="terraform apply — создание ресурсов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="tf_d">
<mxGeometry x="20" y="415" width="320" height="45" as="geometry"/>
</mxCell>
<mxCell id="yc_d" value="Yandex Cloud — ресурсы, создаваемые Terraform" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
<mxGeometry x="950" y="90" width="400" height="560" as="geometry"/>
</mxCell>
<mxCell id="y1_d" value="yandex_vpc_network — виртуальная сеть" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="yc_d">
<mxGeometry x="20" y="50" width="360" height="40" as="geometry"/>
</mxCell>
<mxCell id="y2_d" value="yandex_vpc_subnet — подсеть (10.10.0.0/24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="yc_d">
<mxGeometry x="20" y="105" width="360" height="40" as="geometry"/>
</mxCell>
<mxCell id="y3_d" value="yandex_vpc_gateway — NAT-шлюз (EGRESS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="yc_d">
<mxGeometry x="20" y="160" width="360" height="40" as="geometry"/>
</mxCell>
<mxCell id="y4_d" value="yandex_vpc_route_table — таблица маршрутизации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="yc_d">
<mxGeometry x="20" y="215" width="360" height="40" as="geometry"/>
</mxCell>
<mxCell id="y5_d" value="yandex_vpc_security_group — правила доступа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="yc_d">
<mxGeometry x="20" y="270" width="360" height="40" as="geometry"/>
</mxCell>
<mxCell id="y6_d" value="yandex_compute_disk — загрузочный диск (20 ГБ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="yc_d">
<mxGeometry x="20" y="325" width="360" height="40" as="geometry"/>
</mxCell>
<mxCell id="y7_d" value="yandex_compute_instance — ВМ (2 vCPU, 2 ГБ RAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="yc_d">
<mxGeometry x="20" y="380" width="360" height="40" as="geometry"/>
</mxCell>
<mxCell id="y8_d" value="yandex_vpc_address — статический публичный IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="yc_d">
<mxGeometry x="20" y="435" width="360" height="40" as="geometry"/>
</mxCell>
<mxCell id="a1_d" value="токен, cloud_id, folder_id, ssh-ключ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#D6B656;endArrow=blockThin;" edge="1" parent="1" source="m3_d" target="t1_d">
<mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="a2_d" value="terraform apply (создание ресурсов)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#6C8EBF;endArrow=blockThin;" edge="1" parent="1" source="t6_d" target="yc_d">
<mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="a3_d" value="после apply: DNS, мониторинг, бэкапы — вручную" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#D6B656;endArrow=blockThin;dashed=1;" edge="1" parent="1" source="yc_d" target="m4_d">
<mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="note_d" value="Декларативный подход: конфигурация хранится в репозитории, изменения проходят plan → apply.&#10;Повторный apply не создаёт дубликаты — Terraform приводит состояние к описанному (idempotency)." style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#999999;rounded=1;" vertex="1" parent="1">
<mxGeometry x="350" y="700" width="700" height="60" as="geometry"/>
</mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>